# Set these in Railway → your service → Variables. Never commit real values.

# Admin login (/admin)
ADMIN_EMAIL=
# Generate with: npm run hash-password -- 'your password'
ADMIN_PASSWORD_HASH=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Who may call the API from a browser (your Vercel address, comma-separate several)
ALLOWED_ORIGINS=https://mdfit-srq.vercel.app

# Gym time zone (class dates are computed in this zone)
TZ_NAME=America/New_York

# Attach a Railway Volume mounted at /data so data survives redeploys.
DATA_DIR=/data
LOG_LEVEL=info
NODE_ENV=production

# Your Vercel site address (used for cancel links in confirmation emails)
SITE_URL=https://mdfit-srq.vercel.app

# Optional email notifications via resend.com (free tier is plenty).
# Owner gets an email for every booking/request; clients get a confirmation with a cancel link.
RESEND_API_KEY=
NOTIFY_FROM=MD Fit <bookings@mdfitsrq.com>
# Where owner notifications go (defaults to ADMIN_EMAIL)
NOTIFY_EMAIL=

# Cal.com booking (optional). Paste the key ONLY here in Railway, never in code or chat.
# Cal.com → Settings → Developer → API keys
CAL_API_KEY=
# Any long random string; paste the same value into the Cal.com webhook's "Secret" field.
CAL_WEBHOOK_SECRET=
