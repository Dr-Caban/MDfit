{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/cancel",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/evaluation",
      "destination": "/book?type=eval",
      "permanent": false
    },
    {
      "source": "/call",
      "destination": "/book?type=call",
      "permanent": false
    },
    {
      "source": "/consult",
      "destination": "/#intake",
      "permanent": false
    },
    {
      "source": "/classes",
      "destination": "/#classes",
      "permanent": false
    }
  ]
}
