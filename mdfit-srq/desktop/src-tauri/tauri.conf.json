{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Fit",
  "version": "1.0.0",
  "identifier": "com.mdfitsrq.app",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; frame-ancestors 'none'; object-src 'none'",
      "freezePrototype": true,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "HealthcareAndFitness",
    "shortDescription": "MD Fit: rehab, pain tools and training with Dr. Jared",
    "copyright": "MD Fit",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
