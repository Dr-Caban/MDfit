# Set these in Railway → your service → Variables. Never commit real values.

# Admin login (/admin and /studio)
ADMIN_EMAIL=
# Generate with: npm run hash-password -- 'your password'
ADMIN_PASSWORD_HASH=
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your Vercel site address, no trailing slash (used in the podcast feed + Facebook links)
SITE_URL=https://your-site.vercel.app
# Who may call the API from a browser (your Vercel address)
ALLOWED_ORIGINS=https://your-site.vercel.app

# Facebook PAGE (not a personal profile). See README.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v26.0

# Attach a Railway Volume mounted at /data so data survives redeploys.
DATA_DIR=/data
LOG_LEVEL=info
# Blocks test + seed scripts from ever running here.
NODE_ENV=production
