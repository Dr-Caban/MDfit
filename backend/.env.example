# Set these in Railway → your service → Variables.
# Long random password for the Studio's "Post to Facebook" + subscriber export.
ADMIN_KEY=
# Your Vercel URL(s), comma separated. Use * while testing.
ALLOWED_ORIGINS=https://your-site.vercel.app
# Facebook PAGE (not a personal profile). See README.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v26.0
# Attach a Railway Volume mounted at /data so sign-ups survive redeploys.
DATA_DIR=/data
# info (default) | warn | error | debug
LOG_LEVEL=info
# Railway sets RAILWAY_ENVIRONMENT_NAME=production automatically; set NODE_ENV=production too.
NODE_ENV=production
